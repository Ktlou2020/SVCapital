// ─── SIGNING CONFIGURATION ──────────────────────────────────────────────────
// You should not need to apply this by hand. `npm run apply:android` writes
// all of it into android/app/build.gradle, in the right places, and is safe to
// re-run. This file is the reference for what it writes and why.
//
// What you DO still have to do yourself, because neither can be committed:
//
//   1. cp android-config/uploadkeystore.jks android/app/uploadkeystore.jks
//   2. cp android-config/key.properties.template android/key.properties
//      …then fill in the real storePassword, keyAlias, keyPassword.
//
// Verify with `npm run check:android` before building.
// ─────────────────────────────────────────────────────────────────────────────

// ── ABOVE the `android { }` block ──
// Guarded on exists(): a missing key.properties must not break debug builds or
// a fresh clone. A bare FileInputStream throws.
def keystorePropertiesFile = rootProject.file("key.properties")
def keystoreProperties = new Properties()
if (keystorePropertiesFile.exists()) {
    keystoreProperties.load(new FileInputStream(keystorePropertiesFile))
}

// ── DIRECTLY inside `android { }` ──
// A sibling of defaultConfig / buildTypes — NOT nested within either.
//
// This is the step that has gone wrong before. In the stock Capacitor
// build.gradle, aaptOptions sits INSIDE defaultConfig, so adding this block
// "after aaptOptions" lands it one level too deep. Groovy closures resolve
// owner-first, so the call still falls through to the android extension: it
// works, nothing errors, and nothing warns. The only symptom appears later,
// when someone moves code and signing silently stops applying.
//
// `npm run check:android` now detects this by brace depth and names the block
// it ended up inside. `npm run apply:android` moves it back.
signingConfigs {
    release {
        if (keystorePropertiesFile.exists()) {
            keyAlias      keystoreProperties['keyAlias']
            keyPassword   keystoreProperties['keyPassword']
            storeFile     file(keystoreProperties['storeFile'])
            storePassword keystoreProperties['storePassword']
        }
    }
}

// ── UPDATE the existing buildTypes block inside `android { }` ──
// The signingConfig line below is the one that actually decides whether the
// AAB is signed. Without it the release build is unsigned; debug builds are
// unaffected and nothing complains until Play rejects the upload.
buildTypes {
    release {
        signingConfig signingConfigs.release
        minifyEnabled false
        proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-rules.pro'
    }
}

// ── VERSIONING ──
// Set in mobile/version.json — shared with iOS — and written into defaultConfig
// by apply:android. android/ is gitignored, so version.json is the only copy
// that survives a fresh checkout.
//
// Play requires versionCode to be strictly higher than anything already
// uploaded to the track. Only Play knows what has been used — bump it for
// every upload and never reuse one. check:android cannot verify this.
//
// versionName is the user-visible string, shared with the iOS
// CFBundleShortVersionString. Changing it opens a new iOS train and abandons
// the old one — an approved marketing version is closed and cannot accept
// further uploads. See the README before changing it.

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main activity -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: svcapital://... -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="svcapital" />
            </intent-filter>

            <!-- App link: https://svcapital.co.za/... and the www host.
                 BOTH are needed. Android verifies each host separately and
                 does not treat www as the same site, so a filter naming only
                 the apex leaves every www link opening the browser. Each host
                 named here must serve /.well-known/assetlinks.json itself,
                 with a 200 and no redirect. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="svcapital.co.za" />
                <data android:scheme="https" android:host="www.svcapital.co.za" />
            </intent-filter>

            <!-- App link: the platform host, CLIENT PATHS ONLY.
                 This is where every link the app itself writes lives — the
                 invitation email and SMS, notification links, password
                 resets, /get-app — so without this filter an invited member
                 tapping their invitation still lands in a browser, which is
                 the one thing the invitation was trying to avoid.

                 It is a SEPARATE filter from the two above on purpose. Within
                 one filter Android combines every host with every path, so
                 adding these prefixes to the filter above would have silently
                 restricted the apex and www to them as well.

                 The prefixes are deliberate and staff paths are deliberately
                 absent: /admin and /team must keep opening in a browser,
                 where staff tools are used, rather than being pulled into the
                 app. Adding a prefix here changes where a link opens for
                 everyone, so add one only for a path a client is sent to. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="platform.svcapital.co.za" />
                <data android:pathPrefix="/portal" />
                <data android:pathPrefix="/get-app" />
                <data android:pathPrefix="/signup" />
                <data android:pathPrefix="/login" />
                <data android:pathPrefix="/reset-password" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="svcapital_investments" />

    </application>
</manifest>

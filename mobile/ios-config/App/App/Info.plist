<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- App identity -->
    <key>CFBundleDisplayName</key>
    <string>SV Capital</string>
    <key>CFBundleName</key>
    <string>SVCapital</string>
    <!-- Must match capacitor.config.json appId. co.za.svcapital.investor is a
         separate, never-released App Store Connect record and must not be used. -->
    <key>CFBundleIdentifier</key>
    <string>co.za.svcapital.app</string>
    <!-- The Xcode project (mobile/ios/, gitignored) is the source of truth for
         these at archive time; the values here only seed a fresh `cap add ios`.

         Two separate App Store Connect rules apply:

         1. A marketing version (CFBundleShortVersionString) whose build has been
            approved for sale is a CLOSED train - it accepts no further uploads at
            any build number (error 90186). 4.0.9 build 7 was sale-approved, so
            4.0.9 is closed and 4.1.0 is the next open train.
         2. Within a train, CFBundleVersion must strictly increase (error 90062).

         Build numbers ran 79, 83, 84, 85 and were then reset to 4-7 for 4.0.9,
         which is what made "what is the next build number" ambiguous. Continuing
         from the all-time high instead of restarting keeps them monotonic across
         trains so the question stays unambiguous. -->
    <key>CFBundleVersion</key>
    <string>86</string>
    <key>CFBundleShortVersionString</key>
    <string>4.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>App</string>

    <!-- Supported orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Status bar -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- Main storyboard -->
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- Deep links -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>co.za.svcapital.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>svcapital</string>
            </array>
        </dict>
    </array>

    <!-- Associated Domains (Universal Links) -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:svcapital.co.za</string>
    </array>

    <!-- Push Notifications -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
        <string>fetch</string>
    </array>

    <!-- Privacy usage descriptions (App Store requirement) -->
    <key>NSCameraUsageDescription</key>
    <string>SV Capital uses your camera to scan documents for identity verification (FICA/KYC).</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>SV Capital uses your photo library to upload identity verification documents.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>SV Capital uses Face ID to securely authenticate you into your investment account.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>SV Capital may use your location to comply with financial regulations.</string>

    <!-- ATS: allow HTTPS only -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>svcapital.co.za</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <false/>
            </dict>
            <key>railway.app</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <false/>
            </dict>
        </dict>
    </dict>

    <!-- Export compliance: app only uses standard HTTPS/TLS (exempt from EAR) -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Capacitor bridge config -->
    <key>WKAppBoundDomains</key>
    <array>
        <string>svcapital.co.za</string>
        <string>railway.app</string>
    </array>

</dict>
</plist>

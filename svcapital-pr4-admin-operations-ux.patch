+function _daysAgoLabel(dateVal) {
+  const ts = new Date(dateVal || 0).getTime();
+  if (!ts) return '—';
+  const diff = Date.now() - ts;
+  const days = Math.floor(diff / 86400000);
+  if (days <= 0) return 'today';
+  if (days === 1) return '1 day ago';
+  return `${days} days ago`;
+}
+
+function _flashRow(el) {
+  if (!el) return;
+  const orig = el.style.boxShadow;
+  const origBg = el.style.background;
+  el.style.transition = 'background 0.45s ease, box-shadow 0.45s ease';
+  el.style.background = 'rgba(255,155,12,0.12)';
+  el.style.boxShadow = 'inset 0 0 0 1px rgba(255,155,12,0.35)';
+  setTimeout(() => {
+    el.style.background = origBg || '';
+    el.style.boxShadow = orig || '';
+  }, 1800);
+}

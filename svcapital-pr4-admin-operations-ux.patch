+
+function _closeActionReasonModal() {
+  const overlay = document.getElementById('actionReasonModal');
+  if (!overlay) return;
+  overlay.style.display = 'none';
+  overlay.classList.remove('active');
+}
+
+function openActionReasonModal({ title = 'Add reason', intro = '', placeholder = 'Type details...', confirmLabel = 'Submit', initialValue = '', danger = true, minLength = 6, onSubmit }) {
+  _ensureActionReasonModal();
+  const overlay = document.getElementById('actionReasonModal');
+  const titleEl = document.getElementById('actionReasonTitle');
+  const introEl = document.getElementById('actionReasonIntro');
+  const input = document.getElementById('actionReasonInput');
+  const hint = document.getElementById('actionReasonHint');
+  const oldConfirm = document.getElementById('actionReasonConfirm');
+  const oldCancel = document.getElementById('actionReasonCancel');
+  const confirmBtn = oldConfirm.cloneNode(true);
+  const cancelBtn = oldCancel.cloneNode(true);
+  oldConfirm.replaceWith(confirmBtn);
+  oldCancel.replaceWith(cancelBtn);
+
+  titleEl.textContent = title;
+  introEl.textContent = intro;
+  input.placeholder = placeholder;
+  input.value = initialValue || '';
+  hint.textContent = `Minimum ${minLength} characters. Make the next step clear.`;
+  confirmBtn.textContent = confirmLabel;
+  confirmBtn.className = `btn ${danger ? 'btn--danger' : 'btn--primary'}`;
+
+  overlay.style.display = 'flex';
+  overlay.classList.add('active');
+  setTimeout(() => input.focus(), 30);
+
+  cancelBtn.addEventListener('click', _closeActionReasonModal, { once: true });
+  confirmBtn.addEventListener('click', async () => {
+    const value = (input.value || '').trim();
+    if (value.length < minLength) {
+      hint.textContent = `Please enter at least ${minLength} characters so the next action is clear.`;
+      hint.style.color = '#ef4444';
+      input.focus();
+      return;
+    }
+    hint.style.color = 'var(--text-muted)';
+    confirmBtn.disabled = true;
+    cancelBtn.disabled = true;
+    try {
+      await onSubmit(value);
+      _closeActionReasonModal();
+    } finally {
+      confirmBtn.disabled = false;
+      cancelBtn.disabled = false;
+    }
+  });
+}

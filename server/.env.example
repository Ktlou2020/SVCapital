# ═══════════════════════════════════════════════════════
# SV Capital — Environment Variables
# Copy to .env and fill in your values
# On Railway: set these in the service Variables tab
# ═══════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (Railway PostgreSQL plugin auto-sets this) ─
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/svcapital

# ── JWT Secret (generate a strong random string) ─────
# Example: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=8h

# ── CORS (comma-separated list of allowed frontend origins) ─
# Leave empty to allow all origins (OK for Railway with internal routing)
ALLOWED_ORIGINS=

# ── Smile Identity (KYC / ID verification) ──────────
# Sign up free at smileidentity.com → Dashboard → API Keys
SMILE_PARTNER_ID=
SMILE_API_KEY=
# Set to 'true' for sandbox (no real DHA calls), 'false' for production
SMILE_SANDBOX=true
# Webhook secret: any random string you configure in the Smile dashboard
SMILE_WEBHOOK_SECRET=

# ── Stitch (Bank account verification) ───────────────
# Sign up at stitch.money → Dashboard → API Credentials
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# Set to 'false' for production
STITCH_SANDBOX=true

# ── Optional: Email (for password reset emails) ──────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# FROM_EMAIL=noreply@svcapital.co.za

# ═══════════════════════════════════════════════════════
# SV Capital — Environment Variables
# Copy to .env and fill in your values
# On Railway: set these in the service Variables tab
# ═══════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (Railway PostgreSQL plugin auto-sets this) ─
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/svcapital

# ── JWT Secret (generate a strong random string) ─────
# Example: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=8h

# ── CORS (comma-separated list of allowed frontend origins) ─
# Leave empty to allow all origins (OK for Railway with internal routing)
ALLOWED_ORIGINS=

# ── Optional: Email (for password reset emails) ──────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# FROM_EMAIL=noreply@svcapital.co.za

# ═══════════════════════════════════════════════════════
# SV Capital — Environment Variables
# Copy to .env and fill in your values
# On Railway: set these in the service Variables tab
# ═══════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (Railway PostgreSQL plugin auto-sets this) ─
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/svcapital

# ── JWT Secret (generate a strong random string) ─────
# Example: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=8h

# ── CORS (comma-separated list of allowed frontend origins) ─
# Leave empty to allow all origins (OK for Railway with internal routing)
ALLOWED_ORIGINS=

# ── Smile Identity (KYC / ID verification) ──────────
# Sign up free at smileidentity.com → Dashboard → API Keys
SMILE_PARTNER_ID=
SMILE_API_KEY=
# Set to 'true' for sandbox (no real DHA calls), 'false' for production
SMILE_SANDBOX=true
# Webhook secret: any random string you configure in the Smile dashboard
SMILE_WEBHOOK_SECRET=

# ── Stitch (Bank account verification) ───────────────
# Sign up at stitch.money → Dashboard → API Credentials
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# Set to 'false' for production
STITCH_SANDBOX=true

# ── Paystack (card payments) ─────────────────────
# Sign in to dashboard.paystack.com → Settings → API Keys & Webhooks
#
# CRITICAL: Both keys must be from the SAME environment.
# Mixing a test public key with a live secret key (or vice versa) causes
# "Payment received but could not confirm" — Paystack silently rejects
# cross-environment reference lookups.
#
# For testing: use pk_test_... + sk_test_...
# For production: use pk_live_... + sk_live_...
#
# Public key  → Settings → API Keys → "Public Key"  (starts with pk_)
# Secret key  → Settings → API Keys → "Secret Key"  (starts with sk_)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Ozow (EFT / instant bank payment gateway) ────────
# Sign in to merchant.ozow.com → Settings → Integration Keys
#
# IMPORTANT — there are TWO different keys in Ozow's portal:
#   1. API Key       → used for Ozow REST API calls (not used here)
#   2. Private Key   → used ONLY for SHA-512 hash computation (this is what goes below)
# Using the wrong key is the most common cause of "HashCheck value has failed".
#
# Site Code:    Settings → Integration → your Site Code  (e.g. ABC-DEF-1234)
# Private Key:  Settings → Integration → Private Key     (long alphanumeric string)
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
# Set to 'true' when using Ozow's test environment (IsTest flag in hash + URL)
# Set to 'false' (or leave empty) for production payments
OZOW_IS_TEST=false

# ── Optional: Email (for password reset emails) ──────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# FROM_EMAIL=noreply@svcapital.co.za

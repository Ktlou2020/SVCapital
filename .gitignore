# Wrangler / Cloudflare
.wrangler
.dev.vars*
!.dev.vars.example

# Environment variables — NEVER commit
.env
.env.local
.env.production
server/.env
!server/.env.example

# Node.js
# Without the trailing slash as well as with it. A pattern ending in "/"
# matches a DIRECTORY and not a symlink, so a symlinked node_modules —
# which is what you get after pointing a git worktree at the real one to
# run the checks — sails straight past `git add -A` and gets committed.
# That happened: a symlink to an absolute path inside one container was
# committed and shipped. The Dockerfile copies real modules over it so
# nothing broke, and it still had no business being in the repository.
node_modules
node_modules/
server/node_modules
server/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Claude Code internal state
.claude/

# Build artifacts
# dist/ is intentionally committed — it's the Cloudflare Pages build output
build/
.cache/

# Capacitor mobile — generated native projects and built web assets
# mobile/www/ is committed so GitHub Desktop pull keeps it in sync without needing build.js
mobile/android/
mobile/ios/
mobile/node_modules/

# Android signing credentials — NEVER commit these
*.jks
*.keystore
key.properties
migration-data/

.pgdata/
var/
toggle-test.html
